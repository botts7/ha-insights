# Copy to dev/.env (gitignored) and edit for your environment.

# Timezone for the dev HA instance. Defaults to Etc/UTC if unset.
# Examples: America/Los_Angeles, Europe/Berlin, Asia/Tokyo, Australia/Sydney
TZ=Etc/UTC

# Host port for the dev HA instance. Default 8125 — chosen to avoid clashing
# with HA's default 8123 or any other HA dev/test container you may already
# be running on 8124. Inside the container HA always listens on 8123.
HA_PORT=8125
